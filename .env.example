# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# ci/setup_cai.py copies the Impala login into the CAI project environment.
CASA_IMPALA_USER=your-workload-username
CASA_IMPALA_PASSWORD=your-workload-password
HF_HOME=.hf_cache

# CAI API v2 (ci/setup_cai.py, cde/scripts/set_airflow_variables.py)
CASA_CAI_HOST=https://<workbench-domain>
CASA_CAI_API_KEY=
CASA_CAI_PROJECT_ID=            # printed by ci/setup_cai.py

# Data Visualization (dataviz/build_dashboard.py)
CASA_CDV_URL=https://<viz-instance>/arc/apps/
CASA_CDV_API_KEY=
CASA_VIZ_API_KEY=

# After the CAI model is deployed (for the app's stress tab from a laptop)
# CASA_ENDPOINT_URL=https://modelservice.<workbench-domain>/model
# CASA_ENDPOINT_ACCESS_KEY=
# CASA_ENDPOINT_API_KEY=
